{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verification",
  "account_id": "55ced6868f059310735db3e9fe0eaf10",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
  },
  "no_bundle": true,
  "vars": {
    // Sites are searched in this order and in parallel. The first one receives
    // Report Query leads. Adding a site is one entry here plus a secret pair
    // (ERP_NEXT_API_KEY_<ID> / ERP_NEXT_API_SECRET_<ID>) — no code change.
    "ERP_NEXT_SITES": "[{\"id\":\"dev16\",\"baseUrl\":\"https://dev16.mmmc.pk\"},{\"id\":\"test16\",\"baseUrl\":\"https://test16.mmmc.pk\"},{\"id\":\"staging\",\"baseUrl\":\"https://staging.mmmc.pk\"}]",
    "VERIFICATION_DOCTYPES": "",
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"],
    },
  ],
}
