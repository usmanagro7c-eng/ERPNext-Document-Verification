# Production (build default mode) — verification always runs against the
# Cloudflare Worker proxy, which talks to ERPNext. No mock anywhere.
# Build-time only: VITE_* is inlined at build; local `.env` (dev) is untouched.

# App is served at the workers.dev domain root, so no sub-path. This file wins
# over `.env` in production builds, keeping deploys rooted even if `.env` ever
# sets VITE_SUB_PATH for an ERPNext reverse-proxy build. Only change this to
# /verification when building for a proxy that serves the app under that prefix.
VITE_SUB_PATH=