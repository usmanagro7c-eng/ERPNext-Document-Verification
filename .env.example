# ---------------------------------------------------------------
# Frontend / client bundle
# VITE_* keys are visible in the browser. There are NO secrets here.
# ---------------------------------------------------------------

# Development fallback only. Set to "true" to verify against the bundled mock
# while ERPNext is not yet configured (no network, no env vars needed).
VITE_USE_MOCK_VERIFICATION=true

# ---------------------------------------------------------------
# Runtime configuration — read by the server function inside the
# Cloudflare Worker (and by the local dev server) via process.env.
# These are NOT VITE_ keys, so they never reach the client bundle.
# ---------------------------------------------------------------

# Your ERPNext site, e.g. https://erp.example.com (no trailing slash).
# Local dev: set in the shell before `npm run dev`.
# Cloudflare: create a Variable binding with this name.
ERP_NEXT_BASE_URL=

# Built-in ERPNext API Key / Secret of a restricted user (no app install).
# Local dev: set in the shell before `npm run dev`.
# Cloudflare: create Secret bindings (never put them in .env).
ERP_NEXT_API_KEY=
ERP_NEXT_API_SECRET=

# OPTIONAL fallback: comma-separated doctypes to search when the API user
# cannot read the Custom Field doctype, e.g. Sales Invoice, Purchase Invoice.
# Auto-discovery via the Custom Field doctype is tried first either way.
VERIFICATION_DOCTYPES=

# NOTE: The API Key / Secret are SECRETS — never put real values in a VITE_*
# variable or commit them to the repo.