# ---------------------------------------------------------------
# Runtime configuration — read by the server functions inside the
# Cloudflare Worker (and by the local dev server) via process.env.
# These are NOT VITE_ keys, so they never reach the client bundle.
# ---------------------------------------------------------------

# The ERPNext sites this portal verifies against, as a JSON array. Each entry is
# { id, baseUrl, doctypes? }; `doctypes` is an optional per-site fallback list.
# Sites are searched in this order and in parallel, so a scan takes as long as
# its slowest site rather than the sum of all of them. The FIRST site is the
# default: it receives Report Query leads.
# Local dev: set in the shell before `npm run dev`.
# Cloudflare: create a Variable binding with this name.
ERP_NEXT_SITES=

# Built-in ERPNext API Key / Secret of a restricted user (no app install),
# one pair per site. The suffix is the site id uppercased, with anything that
# is not A-Z or 0-9 turned into an underscore: `dev16` -> ERP_NEXT_API_KEY_DEV16.
# Local dev: set in the shell before `npm run dev`.
# Cloudflare: create Secret bindings (never put them in .env).
ERP_NEXT_API_KEY_DEV16=
ERP_NEXT_API_SECRET_DEV16=
ERP_NEXT_API_KEY_TEST16=
ERP_NEXT_API_SECRET_TEST16=

# OPTIONAL fallback: comma-separated doctypes to search when the API user
# cannot read the Custom Field doctype, e.g. Sales Invoice, Purchase Invoice.
# Auto-discovery via the Custom Field doctype is tried first either way.
# This applies to every site; use VERIFICATION_DOCTYPES_<SITE_ID> (e.g.
# VERIFICATION_DOCTYPES_DEV16) to override the list for one site.
VERIFICATION_DOCTYPES=

# Legacy single-site form, still honoured when ERP_NEXT_SITES is unset:
# ERP_NEXT_BASE_URL=https://erp.example.com
# ERP_NEXT_API_KEY=
# ERP_NEXT_API_SECRET=

# NOTE: The API Key / Secret are SECRETS — never put real values in a VITE_*
# variable or commit them to the repo.